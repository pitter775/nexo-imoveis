# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase project URL used by auth and protected routes.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Public anon key used by existing public/storage pages.
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Server-side key used only by the application to query the public.users table.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Secret used to sign the app-managed session cookie/JWT.
APP_SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# Server-side key used only by the app to call the OpenAI Responses API.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# Optional model override for the property assistant chat.
OPENAI_CHAT_MODEL="gpt-4o-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google OAuth login.
# Callback URL in Google Cloud: https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Mercado Pago Checkout Pro used to charge for property information access.
MERCADO_PAGO_ACCESS_TOKEN="YOUR_MERCADO_PAGO_ACCESS_TOKEN"

# SMTP used to send password reset e-mails.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASS="YOUR_SMTP_PASSWORD"
SMTP_FROM="Nexo Leilões <contato@nexoleiloes.com.br>"
